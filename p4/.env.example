# Copy this file to .env and fill it in.
# From @BotFather on Telegram (send /newbot). Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=
# Optional. The address phones use for the SOS QR codes, e.g. http://192.168.43.10:8000
PUBLIC_URL=
# Optional. People must send /staff CODE to get staff alerts. Leave empty to let anyone be staff.
STAFF_CODE=
PORT=8000
